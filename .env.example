# Copy to .env.local for an isolated emulator session. Restart Vite after edits.
VITE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-riwaayat
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-riwaayat.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=demo-riwaayat.appspot.com
VITE_FIREBASE_APP_ID=demo-app
# Required when EMULATORS=false. Never put Admin credentials in VITE_ variables.
VITE_FIREBASE_APPCHECK_SITE_KEY=

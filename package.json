{
  "name": "riwaayat-rebuild",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/validation.test.mjs tests/csv.test.mjs tests/contact.test.mjs tests/staging-config.test.mjs",
    "emulators": "firebase emulators:start --project demo-riwaayat --only auth,firestore,storage,functions",
    "test:security": "firebase emulators:exec --project demo-riwaayat --only auth,firestore,storage,functions \"node --test tests/rules.test.mjs tests/backend.test.mjs tests/deletion.test.mjs\"",
    "seed:demo": "node tests/seed-demo.mjs",
    "deletions:local": "node scripts/deletions-local.mjs",
    "check:staging": "node scripts/check-staging.mjs",
    "build:staging": "npm run check:staging && tsc --noEmit && vite build --mode staging"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "firebase-tools": "^15.31.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper validation functions for RSVP and Guestbook
    function isValidRsvp() {
      let data = request.resource.data;
      return data.keys().hasOnly(['id', 'name', 'attendance', 'partySize', 'meal', 'ceremonies', 'note', 'createdAt'])
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.attendance in ['yes', 'no']
        && data.partySize is int && data.partySize >= 0 && data.partySize <= 6
        && (data.meal == null || (data.meal is string && data.meal.size() <= 50))
        && data.ceremonies is list && data.ceremonies.size() <= 20
        && data.note is string && data.note.size() <= 500
        && (data.createdAt == request.time || data.createdAt is timestamp);
    }

    function isValidGuestbook() {
      let data = request.resource.data;
      return data.keys().hasOnly(['id', 'displayName', 'message', 'status', 'consent', 'createdAt'])
        && data.id is string && data.id.size() <= 64
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80
        && data.message is string && data.message.size() > 0 && data.message.size() <= 800
        && data.status == 'pending'
        && data.consent == true
        && (data.createdAt == request.time || data.createdAt is timestamp);
    }

    // 1. Private Workspace: Only the account owner can read/write their own drafts and photos
    match /owners/{uid}/events/{eventId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      
      match /photos/{photoId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /rsvps/{replyId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
      match /guestbook/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
    
    // 2. Public Published Invitation: Anyone can read, but only the event owner can modify or delete
    match /events/{eventId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      
      match /photos/{photoId} {
        allow read: if true;
        allow write: if request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
      }

      // Guests can submit an RSVP with strict schema validation; only the host can read/moderate
      match /rsvps/{replyId} {
        allow create: if isValidRsvp();
        allow read, update, delete: if request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
      }
      
      // Guests can leave a guestbook message with strict schema validation; approved visible publicly
      match /guestbook/{entryId} {
        allow create: if isValidGuestbook();
        allow read: if resource.data.status == 'approved' || (request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid);
        allow update, delete: if request.auth != null && get(/databases/$(database)/documents/events/$(eventId)).data.ownerId == request.auth.uid;
      }
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

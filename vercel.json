{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build:staging",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/account", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/privacy", "destination": "/index.html" },
    { "source": "/terms", "destination": "/index.html" },
    { "source": "/data-request", "destination": "/index.html" },
    { "source": "/data-controls", "destination": "/index.html" },
    { "source": "/preview/:id", "destination": "/index.html" },
    { "source": "/edit/:id", "destination": "/index.html" },
    { "source": "/draft/:id", "destination": "/index.html" },
    { "source": "/invite/:id", "destination": "/index.html" },
    { "source": "/responses/:id", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] }
  ]
}
